+++ b/libavcodec/mediacodecdec_common.h
@@ -71,6 +71,13 @@ typedef struct MediaCodecDecContext {
     atomic_int serial;
 
     bool use_ndk_codec;
+
+    /* Set when the codec stopped making progress entirely (see the wedge
+     * watchdog in mediacodecdec.c). A wedged instance never recovers, and on
+     * some Codec2 HALs (c2.rk.avc.decoder) its flush/stop/delete calls block
