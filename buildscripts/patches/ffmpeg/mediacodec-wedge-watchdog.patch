index 9b91c8e..e8e17dc 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -20,6 +20,7 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#include <pthread.h>
 #include <string.h>
 #include <sys/types.h>
 
@@ -901,6 +902,11 @@ int ff_mediacodec_dec_send(AVCodecContext *avctx, MediaCodecDecContext *s,
     int64_t input_dequeue_timeout_us = wait ? INPUT_DEQUEUE_TIMEOUT_US : 0;
     int64_t pts;
 
+    /* A wedged codec never consumes input; fail fast instead of waiting out
+     * the input dequeue timeout on every call. */
+    if (s->wedged)
+        return AVERROR_EXTERNAL;
+
     if (s->flushing) {
         av_log(avctx, AV_LOG_ERROR, "Decoder is flushing and cannot accept new buffer "
                                     "until all output buffers have been released\n");
@@ -1110,6 +1116,13 @@ int ff_mediacodec_dec_receive(AVCodecContext *avctx, MediaCodecDecContext *s,
 */
 int ff_mediacodec_dec_flush(AVCodecContext *avctx, MediaCodecDecContext *s)
 {
+    /* Flushing a wedged codec can block forever inside the HAL (observed
+     * with c2.rk.avc.decoder stuck in its output buffer dequeue loop). The
+     * instance is unusable and about to be torn down anyway, so skip the
+     * codec call and report the flush as performed. */
+    if (s->wedged)
+        return 1;
+
     if (!s->surface || !s->delay_flush || atomic_load(&s->refcount) == 1) {
         int ret;
 
@@ -1126,11 +1139,56 @@ int ff_mediacodec_dec_flush(AVCodecContext *avctx, MediaCodecDecContext *s)
     return 0;
 }
 
+/* Teardown of a wedged codec, running on a detached thread: the HAL may
+ * never return from stop/delete (c2.rk.avc.decoder), and blocking here is
+ * harmless while blocking the decoding thread would freeze the player.
+ * Waits (bounded) for outstanding frame references to drain first, so the
+ * final unref - and with it the possibly-blocking delete - happens on this
+ * thread rather than on whichever playback thread drops the last frame. */
+static void *mediacodec_dec_abandon_thread(void *arg)
+{
+    MediaCodecDecContext *s = arg;
+    int i;
+
+    ff_AMediaCodec_stop(s->codec);
+
+    for (i = 0; i < 1000 && atomic_load(&s->refcount) > 1; i++)
+        av_usleep(10000);
+
+    ff_mediacodec_dec_unref(s);
+
+    return NULL;
+}
+
 int ff_mediacodec_dec_close(AVCodecContext *avctx, MediaCodecDecContext *s)
 {
     if (!s)
         return 0;
 
+    if (s->codec && s->wedged) {
+        pthread_t thread;
+        pthread_attr_t attr;
+        int ret = pthread_attr_init(&attr);
+
+        /* Invalidate output buffers still referenced by frames so their
+         * release does not call back into the dying codec. */
+        atomic_fetch_add(&s->serial, 1);
+
+        if (!ret) {
+            pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+            av_log(avctx, AV_LOG_WARNING,
+                   "Abandoning wedged MediaCodec %s on a detached thread\n",
+                   s->codec_name);
+            ret = pthread_create(&thread, &attr, mediacodec_dec_abandon_thread, s);
+            pthread_attr_destroy(&attr);
+            if (!ret)
+                return 0;
+        }
+        av_log(avctx, AV_LOG_WARNING,
+               "Failed to spawn abandon thread, stopping the wedged codec "
+               "synchronously (this can block)\n");
+    }
+
     if (s->codec) {
         if (atomic_load(&s->hw_buffer_count) == 0) {
             ff_AMediaCodec_stop(s->codec);
