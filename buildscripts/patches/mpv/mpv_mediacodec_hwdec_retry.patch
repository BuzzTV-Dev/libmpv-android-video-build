Recreate a failed mediacodec hwdec instead of falling back to software.

With vo=mediacodec_embed, video frames are MediaCodec output buffers
released straight to the Android Surface; the VO cannot display software
frames at all. When hardware decoding fails at runtime, mpv's generic
fallback ("attempt next method, eventually software") therefore ends in
"Cannot convert decoder/filter output to any format supported by the
output" and the video chain shuts down - audio keeps playing over a
frozen last frame.

Runtime mediacodec failures on these devices are in practice a wedged
codec instance (c2.amlogic.mpeg2.decoder stops making progress after
being flushed shortly after startup; see ffmpeg's
mediacodec-wedge-watchdog.patch which detects this and errors out
instead of hanging). A freshly created codec on the same surface works
fine - the wedged instance releases its buffers on close.

So, before advancing to the next (useless) decoding method, retry the
same mediacodec hwdec up to 2 times by popping it from the
attempted_hwdecs list. The retry budget resets once decoding produces
frames again, and if the fresh instance also fails immediately the
budget runs out and the old fallback behavior applies.

diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index 399e1d51fc..76fd8f6169 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -237,6 +237,7 @@ typedef struct lavc_ctx {
 
     bool hwdec_request_reinit;
     int hwdec_fail_count;
+    int mediacodec_retries;
 
     struct mp_image_pool *hwdec_swpool;
 
@@ -668,6 +669,24 @@ static void force_fallback(struct mp_filter *vd)
 
     uninit_avctx(vd);
     int lev = ctx->hwdec_notified ? MSGL_WARN : MSGL_V;
+    // Runtime mediacodec failures are usually a wedged codec instance (e.g.
+    // c2.amlogic.mpeg2.decoder after a flush storm); a freshly created codec
+    // works again, while falling back to software decoding is useless with
+    // vo=mediacodec_embed, which cannot display software frames at all.
+    // Retry the same hwdec a couple of times before giving up on it.
+    if (ctx->num_attempted_hwdecs > 0 && ctx->mediacodec_retries < 2 &&
+        bstr_find0(ctx->attempted_hwdecs[ctx->num_attempted_hwdecs - 1],
+                   "mediacodec") >= 0)
+    {
+        ctx->mediacodec_retries += 1;
+        mp_msg(vd->log, lev, "Recreating %.*s after failure (attempt %d).\n",
+               BSTR_P(ctx->attempted_hwdecs[ctx->num_attempted_hwdecs - 1]),
+               ctx->mediacodec_retries);
+        ctx->num_attempted_hwdecs -= 1;
+        select_and_set_hwdec(vd);
+        init_avctx(vd);
+        return;
+    }
     mp_msg(vd->log, lev, "Attempting next decoding method after failure of %.*s.\n",
            BSTR_P(ctx->attempted_hwdecs[ctx->num_attempted_hwdecs - 1]));
     select_and_set_hwdec(vd);
@@ -1265,6 +1284,7 @@ static int decode_frame(struct mp_filter *vd)
     }
 
     ctx->hwdec_fail_count = 0;
+    ctx->mediacodec_retries = 0;
 
     mpi->pts = mp_pts_from_av(ctx->pic->pts, &ctx->codec_timebase);
     mpi->dts = mp_pts_from_av(ctx->pic->pkt_dts, &ctx->codec_timebase);
