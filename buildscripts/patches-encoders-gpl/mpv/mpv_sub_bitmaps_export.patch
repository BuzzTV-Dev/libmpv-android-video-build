 /**
+ * A single subtitle bitmap ("part"). Pixel data is 32 bit per pixel BGRA
+ * (native little endian: B is the first byte in memory, A the last) with
+ * premultiplied alpha, tightly packed (stride == w * 4).
+ *
+ * Coordinates are relative to a virtual canvas of size
+ * mpv_sub_bitmaps.canvas_w x mpv_sub_bitmaps.canvas_h. To display, stretch
+ * the canvas over the area where the video is shown, and draw the bitmap
+ * scaled from w x h to dw x dh at position (x, y).
+ */
+typedef struct mpv_sub_bitmap {
+    int32_t x;          // top-left corner x in canvas coordinates
+    int32_t y;          // top-left corner y in canvas coordinates
+    int32_t dw;         // intended display width in canvas coordinates
+    int32_t dh;         // intended display height in canvas coordinates
+    int32_t w;          // bitmap width in pixels
+    int32_t h;          // bitmap height in pixels
+    int32_t stride;     // bytes per bitmap row (always w * 4)
+    uint8_t *pixels;    // w * h premultiplied BGRA pixels
+} mpv_sub_bitmap;
+
+/**
+ * A set of subtitle bitmaps as delivered to the callback registered with
+ * mpv_set_sub_bitmaps_callback(). num_parts == 0 means "no subtitle visible;
+ * clear the overlay".
+ *
+ * The whole structure (including all pointed-to data) lives in a single
+ * allocation owned by the receiver of the callback; release it with
+ * mpv_sub_bitmaps_free() (from any thread) when done.
+ */
+typedef struct mpv_sub_bitmaps {
+    uint64_t serial;    // increments with each callback invocation
+    int32_t canvas_w;   // canvas width the coordinates refer to
+    int32_t canvas_h;   // canvas height the coordinates refer to
+    int32_t num_parts;  // number of entries in parts (0 = clear)
+    mpv_sub_bitmap *parts;
+} mpv_sub_bitmaps;
+
+typedef void (*mpv_sub_bitmaps_callback)(void *userdata, mpv_sub_bitmaps *subs);
+
+/**
+ * Register a callback that receives decoded bitmap subtitles (DVB, PGS,
+ * DVD, ...) for the primary subtitle track, timed to the current playback
+ * position. Text subtitle tracks are NOT delivered here - consume them
+ * through the "sub-text" property instead (delivering libass renderings of
+ * them too would show them twice for hosts that already draw "sub-text").
+ *
+ * The callback only fires while the primary subtitle track is selected,
+ * visible (--sub-visibility=yes) and video is playing.
+ *
+ * This is a custom extension for VOs that cannot render OSD themselves (in
+ * particular --vo=mediacodec_embed on Android, where video frames go straight
+ * to a Surface). The host application is expected to draw the bitmaps on its
+ * own overlay layer above the video. Do not use it together with a VO that
+ * renders subtitles itself (e.g. --vo=gpu) - both would consume the subtitle
+ * decoder's change tracking and each would see incomplete updates.
+ *
+ * The callback is invoked from mpv's core thread whenever the visible
+ * subtitle changes: with num_parts > 0 when a new subtitle (or a changed
+ * position/canvas) should be shown, and with num_parts == 0 when the current
+ * subtitle should be hidden. It is NOT invoked per video frame. The callback
+ * must not block and must not call any mpv client API functions; hand the
+ * data to another thread and return. The mpv_sub_bitmaps pointer stays valid
+ * until the receiver calls mpv_sub_bitmaps_free() on it, which may happen at
+ * any later time from any thread.
+ *
+ * The overlay should also be cleared by the application on MPV_EVENT_END_FILE
+ * and when it deselects the subtitle track while playback is not running, as
+ * no callbacks are generated once playback stops.
+ *
+ * Passing cb = NULL disables the callback again.
+ */
+MPV_EXPORT void mpv_set_sub_bitmaps_callback(mpv_handle *ctx,
+                                             mpv_sub_bitmaps_callback cb,
+                                             void *userdata);
+
+/**
+ * Free a mpv_sub_bitmaps handed to the callback registered with
+ * mpv_set_sub_bitmaps_callback(). Safe to call from any thread.
+ */
+MPV_EXPORT void mpv_sub_bitmaps_free(mpv_sub_bitmaps *subs);
