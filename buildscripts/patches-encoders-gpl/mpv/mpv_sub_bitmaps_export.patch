+// Deliver a copy of *sb (or a "clear" event if sb is NULL) to the registered
+// mpv_set_sub_bitmaps_callback(). See client.h for the data contract.
+static void sub_export_emit(struct MPContext *mpctx, struct sub_bitmaps *sb,
+                            int canvas_w, int canvas_h)
+{
+    int num = sb ? sb->num_parts : 0;
+    size_t size = sizeof(mpv_sub_bitmaps) + num * sizeof(mpv_sub_bitmap);
+    for (int n = 0; n < num; n++)
+        size += (size_t)sb->parts[n].w * sb->parts[n].h * 4;
+
+    mpv_sub_bitmaps *ev = calloc(1, size);
+    if (!ev)
+        return;
+
+    ev->serial = ++mpctx->sub_export_serial;
+    ev->canvas_w = canvas_w;
+    ev->canvas_h = canvas_h;
+    ev->num_parts = num;
+    ev->parts = (mpv_sub_bitmap *)(ev + 1);
+    uint8_t *px = (uint8_t *)(ev->parts + num);
+    for (int n = 0; n < num; n++) {
+        struct sub_bitmap *part = &sb->parts[n];
+        ev->parts[n] = (mpv_sub_bitmap){
+            .x = part->x, .y = part->y,
+            .dw = part->dw, .dh = part->dh,
+            .w = part->w, .h = part->h,
+            .stride = part->w * 4,
+            .pixels = px,
+        };
+        for (int y = 0; y < part->h; y++) {
+            memcpy(px, (uint8_t *)part->bitmap + (size_t)y * part->stride,
+                   (size_t)part->w * 4);
+            px += (size_t)part->w * 4;
+        }
+    }
+
+    mpctx->sub_export_had_sub = num > 0;
+    mpctx->sub_export_cb(mpctx->sub_export_cb_ud, ev);
+}
+
+// Feed the current primary subtitle bitmaps to the host application. This is
+// meant for VOs that cannot render OSD (--vo=mediacodec_embed), where nothing
+// else ever calls sub_get_bitmaps().
+static void sub_export_update(struct MPContext *mpctx, double video_pts)
+{
+    if (!mpctx->sub_export_cb)
+        return;
+
+    // update_subtitles() is reached with slightly different timestamps
+    // depending on the caller (upcoming frame pts vs. playback pts). Around
+    // subtitle boundaries those disagree & the exported state would flip
+    // back & forth for a few frames. Anchor on the currently displayed
+    // frame instead so every call within one frame sees the same state.
+    if (mpctx->video_pts != MP_NOPTS_VALUE)
+        video_pts = mpctx->video_pts;
+
+    struct track *track = mpctx->current_track[0][STREAM_SUB];
+    struct dec_sub *dec_sub = track ? track->d_sub : NULL;
+    struct sub_bitmaps *sb = NULL;
+    int cw = 0, ch = 0;
+
+    // Only bitmap subtitles (sd_lavc: DVB/PGS/DVD/...) are exported. Text
+    // subtitles are expected to be consumed through the "sub-text" property;
+    // exporting their libass rendering here would display them twice.
+    if (dec_sub && track->selected && sub_is_bitmap_sub(dec_sub) &&
+        sub_is_primary_visible(dec_sub) &&
+        video_pts != MP_NOPTS_VALUE && mpctx->vo_chain)
+    {
+        struct mp_image_params params = mpctx->vo_chain->filter->input_params;
+        if (params.imgfmt) {
+            mp_image_params_get_dsize(&params, &cw, &ch);
+            if (cw > 0 && ch > 0) {
+                struct mp_osd_res res = {.w = cw, .h = ch, .display_par = 1};
+                sb = sub_get_bitmaps(dec_sub, res, SUBBITMAP_BGRA, video_pts);
+                if (sb && sb->format != SUBBITMAP_BGRA)
+                    TA_FREEP(&sb);
+            }
+        }
+    }
+
+    if (!sb || !sb->num_parts) {
+        if (mpctx->sub_export_had_sub)
+            sub_export_emit(mpctx, NULL, cw, ch);
+    } else if (!mpctx->sub_export_had_sub || sb->change_id) {
+        sub_export_emit(mpctx, sb, cw, ch);
+    }
+    talloc_free(sb);
+}
