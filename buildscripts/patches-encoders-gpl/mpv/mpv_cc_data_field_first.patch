diff --git a/sub/lavc_conv.c b/sub/lavc_conv.c
index da21033992..89d692aff5 100644
--- a/sub/lavc_conv.c
+++ b/sub/lavc_conv.c
@@ -91,8 +91,13 @@ struct lavc_conv *lavc_conv_create(struct sd *sd)
 
     av_dict_set(&opts, "sub_text_format", "ass", 0);
     av_dict_set(&opts, "flags2", "+ass_ro_flush_noop", 0);
-    if (strcmp(priv->codec, "eia_608") == 0)
+    if (strcmp(priv->codec, "eia_608") == 0) {
         av_dict_set(&opts, "real_time", "1", 0);
+        // Never auto-latch onto CEA-608 field 2: it carries XDS program
+        // metadata and secondary-language captions, and the auto mode locks
+        // onto whichever field appears first in the very first packet.
+        av_dict_set(&opts, "data_field", "first", 0);
+    }
     if (avcodec_open2(avctx, codec, &opts) < 0)
         goto error;
     av_dict_free(&opts);
